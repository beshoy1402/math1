rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isTeacher() {
      return request.auth != null
        && request.auth.uid == "QvrkmJMkEAc30zx4Be62OeJabYi1";
    }
    match /students/{id} { allow read, write: if isTeacher(); }
    match /gradeHistory/{id} { allow read, write: if isTeacher(); }
    match /attendance/{id} { allow read, write: if isTeacher(); }
    match /homework/{id} { allow read, write: if isTeacher(); }
    match /exams/{id} { allow read, write: if isTeacher(); }
    match /groups/{id} { allow read, write: if isTeacher(); }
    match /{document=**} { allow read, write: if false; }
  }
}